{
  "name": "listadeperros-equipo7",
  "version": "3.0.0",
  "description": "Lista de Perros — Equipo 7 · DOY0101 Ingeniería DevOps",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --ci --coverage --json --outputFile=jest-resultados.json",
    "start": "npx serve .",
    "auditoria": "node scripts/auditoria.mjs",
    "monitoreo": "docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d --build",
    "monitoreo:bajar": "docker compose -f docker-compose.yml -f docker-compose.monitoring.yml down"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "logica.js",
      "index.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 70,
        "functions": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "yaml": "^2.9.1"
  }
}
