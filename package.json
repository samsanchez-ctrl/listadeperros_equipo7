{
  "name": "listadeperros-equipo7",
  "version": "2.0.0",
  "description": "Lista de Perros — Equipo 7 · DOY0101 Ingeniería DevOps",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "start": "npx serve ."
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "logica.js",
      "index.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 70,
        "functions": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  }
}
